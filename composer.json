{
  "name": "pharaonic/laravel-translatable",
  "description": "Simplest Translatable for Laravel Eloquent/Model",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "eloquent",
    "model",
    "translatable",
    "translation",
    "translations",
    "multilingual",
    "localization"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/translatable",
    "issues": "https://github.com/Pharaonic/laravel-translatable/issues",
    "source": "https://github.com/Pharaonic/laravel-translatable"
  },
  "require": {
    "php": ">=8.3 <8.6",
    "illuminate/console": "^13.0",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/filesystem": "^13.0",
    "illuminate/http": "^13.0",
    "illuminate/support": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^11.0",
    "phpstan/phpstan": "^2.1.33",
    "phpunit/phpunit": "^12.5.8"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Translatable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Translatable\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Translatable\\TranslatableServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
