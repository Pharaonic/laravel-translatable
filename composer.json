{
  "name": "pharaonic/laravel-translatable",
  "description": "Translated fields for Laravel Eloquent models in three storage strategies behind one API: a translations table, a JSON column per field, or a column per locale.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "eloquent",
    "model",
    "translatable",
    "translation",
    "translations",
    "multilingual",
    "localization"
  ],
  "authors": [
    {
      "name": "Moamen Eltouny (Raggi)",
      "email": "raggigroup@gmail.com"
    }
  ],
  "support": {
    "docs": "https://pharaonic.dev/packages/laravel/translatable",
    "issues": "https://github.com/Pharaonic/laravel-translatable/issues",
    "source": "https://github.com/Pharaonic/laravel-translatable"
  },
  "require": {
    "php": ">=8.0 <8.1",
    "illuminate/console": "^7.30",
    "illuminate/contracts": "^7.30",
    "illuminate/database": "^7.30",
    "illuminate/filesystem": "^7.30",
    "illuminate/http": "^7.30",
    "illuminate/support": "^7.30"
  },
  "require-dev": {
    "laravel/pint": "^1.5",
    "orchestra/testbench": "^5.20",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6.33"
  },
  "autoload": {
    "psr-4": {
      "Pharaonic\\Laravel\\Translatable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pharaonic\\Laravel\\Translatable\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pharaonic\\Laravel\\Translatable\\TranslatableServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
    "format": "@php vendor/bin/pint",
    "format:check": "@php vendor/bin/pint --test",
    "security": "@composer audit",
    "check": [
      "@composer validate --strict",
      "@format:check",
      "@analyse",
      "@test",
      "@security"
    ]
  },
  "config": {
    "audit": {
      "abandoned": "report"
    },
    "policy": {
      "advisories": {
        "block": false,
        "ignore": {
          "laravel/framework": "No fixed release within Laravel 7; the application chooses the framework release.",
          "league/commonmark": "No fixed release within Laravel 7; the application chooses the framework release.",
          "league/flysystem": "No fixed release within Laravel 7; the application chooses the framework release."
        }
      }
    },
    "sort-packages": true
  },
  "prefer-stable": true
}
